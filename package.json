{
  "name": "intent-engine",
  "version": "0.2.0",
  "description": "A schema-driven TypeScript library for mapping natural-language intent to canonical application values.",
  "type": "module",
  "keywords": [
    "ai",
    "intent",
    "intent-mapping",
    "typescript",
    "llm",
    "structured-output",
    "natural-language-processing"
  ],
  "homepage": "https://github.com/BryanReyes-dev/Intent-engine#readme",
  "bugs": {
    "url": "https://github.com/BryanReyes-dev/Intent-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanReyes-dev/Intent-engine.git"
  },
  "license": "MIT",
  "author": "Bryan Reyes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test tests/unit/intent-engine.test.mjs",
    "test:ollama": "npm run build && node --test tests/integration/ollama.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
