{
  "name": "intent-engine",
  "version": "0.1.0",
  "description": "A schema-driven TypeScript library for extracting structured intent from natural-language input.",
  "type": "module",
  "keywords": [
    "ai",
    "intent",
    "semantic-search",
    "typescript",
    "llm",
    "natural-language-processing"
  ],
  "homepage": "https://github.com/BryanReyes-dev/Intent-engine#readme",
  "bugs": {
    "url": "https://github.com/BryanReyes-dev/Intent-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanReyes-dev/Intent-engine.git"
  },
  "license": "MIT",
  "author": "Bryan Reyes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
  "typescript": "^7.0.2"
}
}
